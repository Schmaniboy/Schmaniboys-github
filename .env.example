# Kopie als .env anlegen. .env ist bewusst nicht eingecheckt.

# PostgreSQL-Verbindung
DATABASE_URL="postgresql://benutzer:passwort@localhost:5432/automotive_dev?schema=public"

# Basis-URL der Anwendung. Bestimmt, ob Sitzungscookies als Secure gesetzt werden.
APP_URL="http://localhost:3000"

# Duerfen Suchmaschinen die Seite aufnehmen? Ausdrueckliche Freigabe, damit
# keine Vorschau versehentlich in den Index geraet -- was einmal drin ist,
# steht dort noch, wenn die Adresse laengst nicht mehr stimmt.
# Zum oeffentlichen Start auf "true" setzen. Wirkt auf robots.txt UND auf die
# Meta-Angabe im Wurzel-Layout. Bleibt wirkungslos, solange APP_URL auf
# localhost zeigt.
SUCHMASCHINEN_INDEXIEREN="false"

# Muss in Produktion gesetzt sein. Erzeugen mit:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Wird zum Hashen von IP-Adressen in Audit-Logs verwendet, damit dort keine
# personenbezogene Rohadresse steht.
IP_HASH_SECRET=""

# KI-Zugang. Wird erst in Phase 7 benoetigt und ausschliesslich serverseitig
# verwendet. Niemals mit NEXT_PUBLIC_ praefixen -- das wuerde den Schluessel
# in das Client-Bundle schreiben.
ANTHROPIC_API_KEY=""

# --- Zahlungen (Mollie) -----------------------------------------------------
# Schluessel aus dem Mollie-Dashboard. `test_...` fuer den Testbetrieb,
# `live_...` fuer echtes Geld. Fehlt er, meldet sich der Zahlungsweg als nicht
# eingerichtet -- es wird dann nichts abgebucht und nichts gutgeschrieben.
#
# NIEMALS in die Versionsverwaltung. NIEMALS mit NEXT_PUBLIC_ praefixen --
# das wuerde den Schluessel in das Bundle des Browsers schreiben.
MOLLIE_API_KEY=""

# Adresse, an die Mollie die Zahlungsbenachrichtigung schickt. Muss oeffentlich
# erreichbar sein. Ohne Angabe wird sie aus APP_URL gebildet:
#   ${APP_URL}/api/zahlungen/mollie
# Auf einem Entwicklungsrechner braucht es dafuer einen Tunnel.
MOLLIE_WEBHOOK_URL=""

# --- E-Mail-Versand (SMTP) --------------------------------------------------
# Bewusst SMTP und kein Anbieter-SDK: Dieselben Werte funktionieren mit
# Postmark, Brevo, Mailgun, Amazon SES oder einem eigenen Server. Ein Wechsel
# aendert diese Datei, keinen Code.
#
# Fehlen SMTP_HOST oder SMTP_FROM, meldet sich der Versand als nicht
# eingerichtet. Registrierungen laufen dann ohne Bestaetigungsmail durch, und
# ein vergessenes Passwort ist nicht zuruecksetzbar -- die Seite sagt das auch.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CARONEX <noreply@example.de>"

# E-Mails in die Konsole schreiben statt zu versenden. NUR fuer die
# Entwicklung -- in Produktion wird der Wert ignoriert. Eine Anwendung, die
# Zuruecksetzlinks in ein Serverprotokoll schreibt und sich dabei als
# versandfaehig meldet, gibt Zugaenge preis.
MAIL_TO_CONSOLE="false"

# --- Bildablage -------------------------------------------------------------
#
# Ohne Angaben schreibt die Anwendung ins Dateisystem (IMAGE_STORAGE_DIR).
# Das taugt fuer genau eine Instanz auf einem eigenen Server. Laufen zwei,
# sieht jede nur ihre eigenen Bilder; auf serverlosen Umgebungen (Vercel)
# verschwindet ein Bild ohnehin mit dem Aufruf, und Uploads werden dort
# abgelehnt statt stillschweigend verloren.
#
# Alle fuenf Werte setzen oder keinen. Drei von fuenf sind kein "fast
# fertig", sondern ein Speicher, der erst beim ersten Upload scheitert.
# Funktioniert mit AWS S3, Cloudflare R2, MinIO, Hetzner, Backblaze.
#
# Der Eimer darf NICHT oeffentlich lesbar sein: Ausgeliefert wird ueber
# /api/bilder/..., wo Recht und Medientyp geprueft werden.
#S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
#S3_REGION="eu-central-1"
#S3_BUCKET="automotive-bilder"
#S3_ACCESS_KEY_ID=""
#S3_SECRET_ACCESS_KEY=""
